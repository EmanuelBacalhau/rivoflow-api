{
  "compilerOptions": {
    "lib": [
      "es2024",
      "ESNext.Array",
      "ESNext.Collection",
      "ESNext.Iterator"
    ],
    "module": "nodenext",
    "target": "es2022",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "node16",
    "noImplicitOverride": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    // Path Mapping
    "baseUrl": ".",
    "paths": {
      "@application/*": [
        "src/application/*"
      ],
      "@main/*": [
        "src/main/*"
      ],
      "@infra/*": [
        "src/infra/*"
      ]
    }
  }
}
